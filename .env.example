# Postgres (local, Neon, or Vercel Postgres)
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/gym_checkin"

# NextAuth: generate with `openssl rand -base64 32`; set NEXTAUTH_URL to the deployed URL in production
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Gym timezone for "today", expiry dates and the hourly chart
NEXT_PUBLIC_GYM_TZ="Africa/Casablanca"
